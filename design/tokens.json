        "gapSurface": "{colour.light.surface1}"
      },
      "positive": "gain",
      "negative": "loss"
    }
  },
  "typography": {
    "unit": "sp (size, lineHeight); dp (letterSpacing)",
    "family": {
      "name": "Poppins GP",
      "files": {
        "400": "PoppinsGP-Regular",
        "500": "PoppinsGP-Medium",
        "600": "PoppinsGP-SemiBold"
      },
      "source": "design/fonts/ (SIL OFL 1.1, built by build_poppins_gp.py)",
      "tabularDigits": true,
      "thousandsSeparator": "U+202F"
    },
    "minSize": 12,
    "scale": {
      "amountHero": {
        "size": 34,
        "lineHeight": 42,
        "weight": 600,
        "letterSpacing": -0.5,
        "tabular": true,
        "maxFontSizeMultiplier": 1.5
      },
      "titleScreen": {
        "size": 24,
        "lineHeight": 32,
        "weight": 600
      },
      "amountLarge": {
        "size": 22,
        "lineHeight": 28,
        "weight": 600,
        "tabular": true
      },
      "titleSection": {
        "size": 18,
        "lineHeight": 26,
        "weight": 600
      },
      "bodyStrong": {
        "size": 15,
        "lineHeight": 22,
        "weight": 500
      },
      "amountRow": {
        "size": 15,
        "lineHeight": 22,
        "weight": 600,
        "tabular": true
      },
      "body": {
        "size": 15,
        "lineHeight": 22,
        "weight": 400
      },
      "button": {
        "size": 15,
        "lineHeight": 20,
        "weight": 600
      },
      "label": {
        "size": 13,
        "lineHeight": 18,
        "weight": 500
      },
      "caption": {
        "size": 13,
        "lineHeight": 18,
        "weight": 400
      },
      "micro": {
        "size": 12,
        "lineHeight": 16,
        "weight": 500
      }
    },
    "largeFont": {
      "allowFontScaling": true,
      "fixedRowHeightUpToScale": 1.3,
      "truncate": false
    }
  },
  "spacing": {
    "unit": "dp",
    "s1": 4,
    "s2": 8,
    "s3": 12,
    "s4": 16,
    "s5": 20,
    "s6": 24,
    "s8": 32,
    "s10": 40,
    "s12": 48,
    "s16": 64
  },
  "layout": {
    "referenceScreen": [
      360,
      800
    ],
    "screenMargin": 20,
    "contentWidthAt360": 320,
    "maxContentWidth": 480,
    "topBarHeight": 56,
    "iconButton": 40,
    "minTouchTarget": 48,
    "minTargetGap": 8,
    "sectionGap": 32,
    "sectionTitleHeight": 32,
    "sectionTitleToContent": 12,
    "heroTopGap": 24,
    "heroAmountToChange": 12,
    "dividerGap": 24,
    "cardPadding": 16,
    "listRow": {
      "twoLines": 64,
      "oneLine": 56,
      "sidePadding": 16,
      "leading": 40,
      "leadingToText": 12,
      "separatorInset": 68
    },
    "tiles": {
      "columns": 2,
      "gap": 12
    },
    "grid": {
      "columns": 4,
      "gutter": 16
    },
    "tabBarHeight": 64,
    "bottomButton": {
      "height": 52,
      "bottomGap": 16,
      "clearSpaceAbove": 40
    },
    "sheet": {
      "handle": [
        32,
        4
      ],
      "sidePadding": 20,
      "topPadding": 24
    }
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "cardVisual": 14,
    "lg": 20,
    "pill": 999
  },
  "elevation": {
    "shadows": false,
    "levels": {
      "0": {
        "surface": "bg",
        "separation": "none"
      },
      "1": {
        "surface": "surface1",
        "separation": "border.hairline"
      },
      "2": {
        "surface": "surface2",
        "separation": "none"
      },
      "3": {
        "surface": "surface1",
        "separation": "scrim",
        "radius": "lg"
      }
    },
    "focusRing": {
      "width": 2,
      "offset": 2,
      "colour": "focus"
    }
  },
  "format": {
    "$description": "F6 display formats, see foundations/formats.md",
    "chars": {
      "thousandsFr": " ",
      "beforeUnit": " ",
      "beforePercentFr": " ",
      "minus": "−",
      "rangeDash": "–",
      "hidden": "•••"
    },
    "currency": {
      "XOF": {
        "decimals": 0,
        "suffixFr": "F CFA",
        "suffixRow": "F",
        "exampleFr": "1 250 000 F CFA",
        "exampleEn": "1,250,000 F CFA"
      },
      "XAF": {
        "decimals": 0,
        "suffixFr": "F CFA",
        "suffixRow": "F"
      },
      "EUR": {
        "decimals": 2,
        "exampleFr": "1 234,56 €",
        "exampleEn": "€1,234.56"
      },
      "USD": {
        "decimals": 2,
        "exampleFr": "1 234,56 $",
        "exampleEn": "$1,234.56"
      }
    },
    "abbreviation": {
      "usedIn": [
        "heroOverflow",
        "chartAxis",
        "widget"
      ],
      "million": {
        "fr": "M",
        "en": "M",
        "min": 1000000
      },
      "billion": {
        "fr": "Md",
        "en": "B",
        "min": 1000000000
      },
      "thousandAxisOnly": {
        "fr": "k",
        "en": "k",
        "min": 1000
      },
      "decimals": 1,
      "dropZeroDecimal": true
    },
    "percent": {
      "changeDecimals": 1,
      "noDecimalFrom": 100,
      "shareDecimals": 0,
      "shareRounding": "largestRemainder",
      "zero": "0 %"
    },
    "date": {
      "time": "HH:mm",
      "justNowUnderSec": 60,
      "minutesUnderMin": 60,
      "hoursSameDay": true,
      "yesterday": true,
      "thisYearFr": "d MMM",
      "otherYearFr": "d MMM yyyy",
      "thisYearEn": "MMM d",
      "otherYearEn": "MMM d, yyyy",
      "groupHeaderFr": "EEEE d MMMM",
      "countdown": "m:ss"
    }
  },
  "icon": {
    "$description": "F4 iconography, see foundations/icons.md",
    "set": "lucide",
    "setVersion": "1.77.0",
    "absoluteStrokeWidth": true,
    "size": {
      "lg": {
        "size": 24,
        "stroke": 2
      },
      "md": {
        "size": 20,
        "stroke": 1.75
      },
      "sm": {
        "size": 16,
        "stroke": 1.75
      }
    },
    "avatar": {
      "size": 40,
      "categoryFill": "surface2",
      "bankInitialsColour": "#060606",
      "bankFills": "{colour.chart.dark.series}"
    },
    "ownGlyphs": {
      "changeArrow": {
        "w": 10,
        "h": 8
      },
      "statusShape": 10
    },
    "press": {
      "scale": 0.9,
      "durationMs": 150
    },
    "tabActivate": {
      "scale": [
        0.9,
        1.08,
        1
      ],
      "durationMs": 250
    }
  }
}
