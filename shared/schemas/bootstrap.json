{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenpiece.invalid/schemas/bootstrap.json",
  "title": "api.bootstrap(p_etag) response: envelope whose data is below (API.md §2.1)",
  "allOf": [{ "$ref": "common.json#/$defs/envelope" }],
  "properties": {
    "data": {
      "type": "object",
      "required": ["profile", "min_version", "learning", "consents_current", "card", "devices_count", "flags"],
      "properties": {
        "profile": {
          "type": "object",
          "required": ["language", "country", "timezone", "ref_currency", "risk_profile", "hide_amounts_in_push", "is_demo"],
          "properties": {
            "language": { "$ref": "common.json#/$defs/lang" },
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "timezone": { "type": "string" },
            "ref_currency": { "$ref": "common.json#/$defs/currency" },
            "risk_profile": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
            "hide_amounts_in_push": { "type": "boolean" },
            "data_saver": { "type": "boolean" },
            "lock_delay_s": { "type": "integer" },
            "is_demo": { "type": "boolean" },
            "demo_persona": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "min_version": { "type": "object", "properties": { "android": { "type": "string" } } },
        "learning": {
          "type": "object",
          "required": ["active", "days", "ops"],
          "properties": { "active": { "type": "boolean" }, "days": { "type": "integer" }, "ops": { "type": "integer" } },
          "additionalProperties": false
        },
        "consents_current": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "granted", "text_version", "at"],
            "properties": {
              "kind": { "enum": ["service", "ai_categorisation", "notifications", "crash_reports", "terms", "privacy"] },
              "granted": { "type": "boolean" },
              "text_version": { "type": "string" },
              "at": { "$ref": "common.json#/$defs/timestamp" }
            },
            "additionalProperties": false
          }
        },
        "card": {
          "type": ["object", "null"],
          "properties": {
            "brand": { "enum": ["visa", "mastercard", "amex", "other"] },
            "last4": { "type": "string", "pattern": "^\\d{4}$" },
            "bank_name": { "type": ["string", "null"] }
          }
        },
        "devices_count": { "type": "integer", "minimum": 0 },
        "flags": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "examples": [{
    "etag": "3f2a", "as_of": "2026-11-23T15:00:00Z", "not_modified": false,
    "data": {
      "profile": { "language": "fr", "country": "SN", "timezone": "Africa/Dakar", "ref_currency": "XOF", "risk_profile": null, "hide_amounts_in_push": true, "data_saver": false, "lock_delay_s": 300, "is_demo": false, "demo_persona": null },
      "min_version": { "android": "0.0.0" }, "learning": { "active": false, "days": 0, "ops": 0 },
      "consents_current": [{ "kind": "terms", "granted": true, "text_version": "0.1-draft", "at": "2026-11-23T15:00:00Z" }],
      "card": null, "devices_count": 1, "flags": {}
    }
  }]
}
