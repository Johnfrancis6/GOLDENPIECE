{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenpiece.invalid/schemas/search_instruments.json",
  "title": "api.search_instruments(p_q) response: ≤ 20 instruments (API.md §2.4)",
  "type": "array",
  "maxItems": 20,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "class",
      "currency",
      "proxy_of"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "class": {
        "type": "string"
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "description": "ISO 4217 (quote currency; may be outside the money set)"
      },
      "proxy_of": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "examples": [
    [
      {
        "id": "EFA",
        "name": "Pays développés hors USA",
        "class": "etf",
        "currency": "USD",
        "proxy_of": "MSCI EAFE"
      },
      {
        "id": "XAU",
        "name": "Or",
        "class": "commodity",
        "currency": "USD",
        "proxy_of": null
      },
      {
        "id": "GLD",
        "name": "Or (ETF)",
        "class": "etf",
        "currency": "USD",
        "proxy_of": "Or"
      }
    ]
  ]
}
