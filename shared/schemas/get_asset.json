{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenpiece.invalid/schemas/get_asset.json",
  "title": "api.get_asset(p_instrument_id, p_range, p_etag) response (API.md §2.4; 5Y monthly = BACKEND_NEEDS #8)",
  "allOf": [
    {
      "$ref": "common.json#/$defs/envelope"
    }
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument",
        "range",
        "interval",
        "candles",
        "stats",
        "my_position",
        "attribution_text_key",
        "history_attribution_text_key"
      ],
      "properties": {
        "instrument": {
          "type": "object",
          "required": [
            "id",
            "name",
            "class",
            "currency",
            "unit",
            "proxy_of",
            "group"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "class": {
              "type": "string"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO 4217 (quote currency; may be outside the money set)"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "proxy_of": {
              "type": [
                "string",
                "null"
              ]
            },
            "group": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "range": {
          "enum": [
            "3M",
            "1Y",
            "5Y"
          ]
        },
        "interval": {
          "enum": [
            "day",
            "month"
          ]
        },
        "candles": {
          "type": "array",
          "maxItems": 260,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 5,
            "maxItems": 5
          },
          "description": "[d, o, h, l, c], oldest first; 5Y (and monthly series) = monthly candles ≤ 60"
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "last",
            "as_of",
            "freshness",
            "change_1d",
            "change_1y",
            "vol_ann",
            "beta",
            "benchmark"
          ],
          "properties": {
            "last": {
              "type": [
                "number",
                "null"
              ]
            },
            "as_of": {
              "type": [
                "string",
                "null"
              ]
            },
            "freshness": {
              "enum": [
                "delayed",
                "daily",
                "monthly",
                "peg"
              ]
            },
            "change_1d": {
              "type": [
                "number",
                "null"
              ]
            },
            "change_1y": {
              "type": [
                "number",
                "null"
              ]
            },
            "vol_ann": {
              "type": [
                "number",
                "null"
              ],
              "description": "annualised volatility (fraction) of daily log returns over 1 year; null if < 60 returns"
            },
            "beta": {
              "type": [
                "number",
                "null"
              ],
              "description": "vs benchmark over 1 year; null if < 120 overlapping returns"
            },
            "benchmark": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "my_position": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "qty",
            "currency",
            "avg_cost_minor",
            "cost_minor",
            "realised_minor"
          ],
          "properties": {
            "qty": {
              "type": "number"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO 4217 (quote currency; may be outside the money set)"
            },
            "avg_cost_minor": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cost_minor": {
              "type": "integer"
            },
            "realised_minor": {
              "type": "integer"
            },
            "value_minor": {
              "type": "integer"
            }
          }
        },
        "attribution_text_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "history_attribution_text_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
