{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenpiece.invalid/schemas/get_markets.json",
  "title": "api.get_markets(p_etag) response: envelope whose data is below (API.md §2.5, design B9)",
  "allOf": [
    {
      "$ref": "common.json#/$defs/envelope"
    }
  ],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "groups",
        "attributions"
      ],
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "enum": [
                  "indices",
                  "metals",
                  "energy",
                  "agri",
                  "crypto",
                  "fx"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                }
              }
            }
          }
        },
        "attributions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^attr\\.[a-z]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "name",
        "class",
        "currency",
        "unit",
        "price",
        "change_pct",
        "change_30d_pct",
        "spark_30d",
        "as_of",
        "freshness",
        "proxy_of"
      ],
      "properties": {
        "instrument_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "class": {
          "enum": [
            "equity",
            "etf",
            "crypto",
            "commodity",
            "fx",
            "index_proxy"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 (quote currency; may be outside the money set)"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "price unit after the currency: oz, bbl, t, lb (null = currency only)"
        },
        "price": {
          "type": [
            "number",
            "null"
          ]
        },
        "change_pct": {
          "type": [
            "number",
            "null"
          ],
          "description": "day change % (monthly series: vs previous month)"
        },
        "change_30d_pct": {
          "type": [
            "number",
            "null"
          ],
          "description": "change over 1 month (B9); monthly series: vs ≈ 2 months back"
        },
        "spark_30d": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "number"
          },
          "description": "≤ 30 daily closes, oldest first (monthly series: ≤ 13 monthly points)"
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "freshness": {
          "enum": [
            "delayed",
            "daily",
            "monthly",
            "peg"
          ]
        },
        "proxy_of": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
