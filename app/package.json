{
  "name": "goldenpiece-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.119.2",
    "@types/jest": "30.0.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "lucide-react-native": "^1.78.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "export:web": "expo export --platform web"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__tests__/nodeDb.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|lucide-react-native)"
    ],
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    }
  }
}
